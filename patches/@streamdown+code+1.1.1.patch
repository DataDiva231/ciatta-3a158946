+import { createHighlighterCore } from '@shikijs/core';
+import { createJavaScriptRegexEngine } from 'shiki/engine/javascript';
+
+// PATCHED (see /patches/@streamdown+code+*.patch): the stock implementation
+// statically imports shiki's *entire* ~200-language registry just to build a
+// name->id lookup table, even though only one language is ever loaded at a
+// time. That's fine in a browser (each language is its own lazily-fetched
+// chunk), but a single-file deploy target (e.g. Cloudflare Workers) has to
+// inline every statically-discoverable dynamic import(), so the whole
+// registry — ~8MB — ends up in the bundle regardless of what's actually
+// used. This version uses shiki's fine-grained/core bundle API with a
+// curated language list instead. Unsupported languages fall back to plain
+// text, same as upstream. Extend LANG_IMPORTS if another language is needed.
+const LANG_IMPORTS = {
+  javascript: () => import('shiki/langs/javascript.mjs'),
+  typescript: () => import('shiki/langs/typescript.mjs'),
+  jsx: () => import('shiki/langs/jsx.mjs'),
+  tsx: () => import('shiki/langs/tsx.mjs'),
+  json: () => import('shiki/langs/json.mjs'),
+  jsonc: () => import('shiki/langs/jsonc.mjs'),
+  shellscript: () => import('shiki/langs/shellscript.mjs'),
+  python: () => import('shiki/langs/python.mjs'),
+  markdown: () => import('shiki/langs/markdown.mjs'),
+  sql: () => import('shiki/langs/sql.mjs'),
+  yaml: () => import('shiki/langs/yaml.mjs'),
+  html: () => import('shiki/langs/html.mjs'),
+  css: () => import('shiki/langs/css.mjs'),
+};
+
+const LANG_ALIASES = {
+  js: 'javascript',
+  cjs: 'javascript',
+  mjs: 'javascript',
+  ts: 'typescript',
+  cts: 'typescript',
+  mts: 'typescript',
+  bash: 'shellscript',
+  sh: 'shellscript',
+  shell: 'shellscript',
+  zsh: 'shellscript',
+  py: 'python',
+  md: 'markdown',
+  yml: 'yaml',
+};
+
+// Only the two themes @streamdown/code defaults to are pre-wired; a custom
+// ThemeInput (non-string) passed via options.themes is passed through as-is.
+const THEME_IMPORTS = {
+  'github-light': () => import('@shikijs/themes/github-light'),
+  'github-dark': () => import('@shikijs/themes/github-dark'),
+};
+
+const SUPPORTED = new Set(Object.keys(LANG_IMPORTS));
+const engine = createJavaScriptRegexEngine({ forgiving: true });
+
+const highlighterCache = new Map();
+const resultCache = new Map();
+const pendingCallbacks = new Map();
+
+function themeName(t) {
+  return typeof t === 'string' ? t : (t?.name ?? 'custom');
+}
+
+function normalizeLanguage(language) {
+  const lang = String(language ?? '').trim().toLowerCase();
+  return LANG_ALIASES[lang] ?? lang;
+}
+
+function highlighterKey(lang, themes) {
+  return `${lang}-${themeName(themes[0])}-${themeName(themes[1])}`;
+}
+
+function resultKey(code, lang, themes) {
+  const head = code.slice(0, 100);
+  const tail = code.length > 100 ? code.slice(-100) : '';
+  return `${lang}:${themeName(themes[0])}:${themeName(themes[1])}:${code.length}:${head}:${tail}`;
+}
+
+function resolveTheme(t) {
+  if (typeof t !== 'string') return t;
+  const loader = THEME_IMPORTS[t];
+  return loader ? loader() : t;
+}
+
+function getHighlighter(lang, themes) {
+  const key = highlighterKey(lang, themes);
+  if (highlighterCache.has(key)) return highlighterCache.get(key);
+  const highlighter = createHighlighterCore({
+    themes: themes.map(resolveTheme),
+    langs: SUPPORTED.has(lang) ? [LANG_IMPORTS[lang]()] : [],
+    engine,
+  });
+  highlighterCache.set(key, highlighter);
+  return highlighter;
+}
+
+function createCodePlugin(options = {}) {
+  const themes = options.themes ?? ['github-light', 'github-dark'];
+  return {
+    name: 'shiki',
+    type: 'code-highlighter',
+    supportsLanguage(language) {
+      return SUPPORTED.has(normalizeLanguage(language));
+    },
+    getSupportedLanguages() {
+      return Array.from(SUPPORTED);
+    },
+    getThemes() {
+      return themes;
+    },
+    highlight({ code, language, themes: reqThemes }, callback) {
+      const lang = normalizeLanguage(language);
+      const key = resultKey(code, lang, reqThemes);
+      if (resultCache.has(key)) return resultCache.get(key);
+      if (callback) {
+        if (!pendingCallbacks.has(key)) pendingCallbacks.set(key, new Set());
+        pendingCallbacks.get(key).add(callback);
+      }
+      const effectiveLang = SUPPORTED.has(lang) ? lang : 'text';
+      getHighlighter(effectiveLang, reqThemes)
+        .then((highlighter) => {
+          const loadedLang = highlighter.getLoadedLanguages().includes(effectiveLang)
+            ? effectiveLang
+            : 'text';
+          const tokens = highlighter.codeToTokens(code, {
+            lang: loadedLang,
+            themes: { light: themeName(reqThemes[0]), dark: themeName(reqThemes[1]) },
+          });
+          resultCache.set(key, tokens);
+          const callbacks = pendingCallbacks.get(key);
+          if (callbacks) {
+            for (const cb of callbacks) cb(tokens);
+            pendingCallbacks.delete(key);
+          }
+        })
+        .catch((err) => {
+          console.error('[Streamdown Code] Failed to highlight code:', err);
+          pendingCallbacks.delete(key);
+        });
+      return null;
+    },
+  };
+}
+
+const code = createCodePlugin();
+
+export { code, createCodePlugin };
